                                    "snippet": {
                                        "text": "        check(prefs.edit().putString(\"peer-remote-$id\",Base64.encodeToString(cipher.iv+cipher.doFinal(data.toString().toByteArray()),Base64.NO_WRAP)).commit())\n        // Upgrade a v0.3 room-only entry to the PC's stable local identity.\n        prefs.all.keys.filter{it.startsWith(\"peer-remote-\")&&it!=\"peer-remote-$id\"}.forEach{entry->runCatching{val old=read(entry.removePrefix(\"peer-\"))?:return@runCatching;val previous=JSONObject(String(Base64.decode(old.getString(\"code\"),Base64.URL_SAFE or Base64.NO_WRAP or Base64.NO_PADDING),Charsets.UTF_8));if(previous.optString(\"room\")==payload.optString(\"room\")&&previous.optString(\"service\")==payload.optString(\"service\"))prefs.edit().remove(entry).commit()}}\n        setLast(id);peer\n    }\n"
                                    }
                                }
                            }
                        }
