{
  "name": "actionbridge-connect",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ConnectionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConnectionRoom"
      ]
    }
  ],
  "vars": {
    "REGISTRATION_ENABLED": "false",
    "RELAY_ENABLED": "false",
    "AUTO_ENROLLMENT_ENABLED": "true"
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "ENROLL_IP_LIMIT",
      "namespace_id": "458331",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "ENROLL_GLOBAL_LIMIT",
      "namespace_id": "458332",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
